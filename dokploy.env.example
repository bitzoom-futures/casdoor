# 复制到 Dokploy → futures_auth 项目 → Environment Variables
ENV=prod
DOMAIN=auth.riverwa.com
ORIGIN=https://auth.riverwa.com
# STATIC_BASE_URL 默认已被代码忽略：静态资源前缀跟随页面请求的域名。
# 保留仅为切回外部 CDN 时备用，届时还需设置 staticBaseUrlMode=config。
STATIC_BASE_URL=https://auth1.riverwa.com
DB_NAME=auth
DB_USER=auth_user
# 密码勿含 @：Casdoor Go 驱动不会解码 DSN 里的 %40
DB_PASSWORD=bitZoom2025_auth
MYSQL_ROOT_PASSWORD=change-me-root-password
DATA_SOURCE_NAME=auth_user:bitZoom2025_auth@tcp(mysql:3306)/